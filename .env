# ==========================================================================
#  Einstellungen für docker compose. Diese Datei wird automatisch gelesen.
#  Nur HOST_IP muss angepasst werden – die Ports können so bleiben.
# ==========================================================================

# IP-Adresse Ihrer Docker-VM, so wie Sie sie im Browser eintippen.
# Herausfinden auf der VM z. B. mit:   hostname -I
# Beispiel: HOST_IP=192.168.178.42
HOST_IP=localhost

# Ports auf der VM. Bewusst nicht die Standardports, damit nichts kollidiert.
DASHBOARD_PORT=28080
TEMPORAL_UI_PORT=28233
TEMPORAL_PORT=27233
KAFKA_PORT=29092
POSTGRES_PORT=25432

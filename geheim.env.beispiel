# Vorlage für Zugangsdaten. So verwenden:
#
#     cp geheim.env.beispiel geheim.env
#     nano geheim.env
#
# Die Datei "geheim.env" steht in der .gitignore und wird niemals
# mitversioniert – Ihr Schlüssel bleibt auf Ihrer Maschine.

# Claude-API-Schlüssel (optional). Damit liest der mde-agent die MdE
# inhaltlich aus dem hochgeladenen Gutachten statt per Textsuche.
# Zu finden unter: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

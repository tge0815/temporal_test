# ==========================================================================
#  VORLAGE für die Einstellungen. So verwenden:
#
#      cp .env.beispiel .env
#      nano .env            # HOST_IP eintragen
#
#  Die Datei ".env" selbst liegt NICHT im Git (siehe .gitignore). Dadurch
#  bleiben Ihre Einstellungen bei einem "git pull" unangetastet.
#  Ohne .env startet alles trotzdem – dann gelten die Werte hier als
#  Voreinstellung und HOST_IP ist "localhost".
# ==========================================================================

# IP-Adresse Ihrer Docker-VM, so wie Sie sie im Browser eintippen.
# Herausfinden auf der VM z. B. mit:   hostname -I
# Beispiel: HOST_IP=192.168.178.42
HOST_IP=localhost

# Ports auf der VM. Bewusst nicht die Standardports, damit nichts kollidiert.
DASHBOARD_PORT=28080
TEMPORAL_UI_PORT=28233
TEMPORAL_PORT=27233
KAFKA_PORT=29092
POSTGRES_PORT=25432

# --------------------------------------------------------------------------
#  Wartezeiten der Demo
# --------------------------------------------------------------------------
# So lange wartet der Workflow auf Gutachten bzw. Entgeltmeldung, bevor er
# eine Erinnerung verschickt. Danach wartet er weiter - unbegrenzt.
# In der Wirklichkeit waeren das Tage oder Wochen.
FRIST_GUTACHTEN_SEKUNDEN=30
FRIST_ENTGELTMELDUNG_SEKUNDEN=30

# --------------------------------------------------------------------------
#  Claude API (optional)
# --------------------------------------------------------------------------
# Mit hinterlegtem Schluessel liest der mde-agent die MdE inhaltlich aus dem
# hochgeladenen Gutachten. Ohne Schluessel funktioniert die Demo weiterhin -
# dann sucht der Agent den Wert per Textsuche.
#
# ACHTUNG: Der Schluessel gehoert NICHT in diese Datei - sie liegt im Git.
# Legen Sie ihn stattdessen in einer Datei "geheim.env" daneben ab:
#
#     cp geheim.env.beispiel geheim.env
#     nano geheim.env          # Schluessel eintragen
#
# "geheim.env" steht in der .gitignore und wird nie mitversioniert.
CLAUDE_MODELL=claude-opus-5
